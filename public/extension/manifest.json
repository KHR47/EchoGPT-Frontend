{
  "manifest_version": 3,
  "name": "EchoGPT - Multi-AI Chrome Side Panel",
  "version": "2.0.0",
  "description": "Context-aware AI productivity: chat with 320+ models, summarize webpages, explain selected text, and compare responses in your side panel.",
  "author": "EchoGPT (AppifyDevs)",
  "homepage_url": "https://echogpt.live",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open EchoGPT Side Panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Toggle EchoGPT Side Panel"
    }
  }
}
